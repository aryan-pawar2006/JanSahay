# ==============================================================================
# JanSahay Backend Environment Configuration Template (Render + Aiven MySQL)
# ==============================================================================

# Server Port (automatically set by Render in production)
PORT=8080

# Aiven MySQL Database Connection Parameters
DB_HOST=mysql-xxxxxxxx-your-project.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_mysql_password
DB_SSL=true
DB_SSL_MODE=REQUIRED

# Optional: Direct Full Database URL (if copying the service URI from Aiven directly)
# SPRING_DATASOURCE_URL=jdbc:mysql://avnadmin:password@mysql-xxxx.aivencloud.com:12345/defaultdb?sslMode=REQUIRED

# Security & JWT (Must be at least 32 characters / 256-bit secret)
JWT_SECRET=JanSahayAI_Production_Super_Secure_Secret_Key_32_Chars_Min!

# Allowed CORS Origins (comma separated - *.vercel.app is allowed by default)
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app

# Database Seeding (always seeds default 32+ schemes and demo accounts safely)
SQL_INIT_MODE=always

# AI Provider (mock for deterministic zero-cost offline, or gemini)
AI_PROVIDER=mock
GEMINI_API_KEY=
